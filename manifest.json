{
  "id": "monitor",
  "description": "External process watchdog and failure-diagnostics console.",
  "version": "0.2.0",
  "cpp_standard": 20,
  "facade": "watchdog_cli:cli",
  "install_artifacts": [
    "watchdog_client:client",
    "watchdog_qt:qt"
  ],
  "artifacts": [
    {
      "id": "watchdog_contract:contract",
      "kind": "interface_lib",
      "name": "monitor_watchdog_contract",
      "root": "core",
      "owns": [
        "include/monitor/shared_state.hpp"
      ]
    },
    {
      "id": "watchdog_platform:platform",
      "kind": "static_lib",
      "name": "monitor_watchdog_platform",
      "root": "core",
      "owns": [
        "include/monitor/platform/process_watch.hpp",
        "src/monitor/platform/process_watch.cpp",
        "include/monitor/platform/shared_memory.hpp",
        "src/monitor/platform/shared_memory.cpp"
      ],
      "dependencies": [
        "watchdog_contract:contract"
      ]
    },
    {
      "id": "watchdog_client:client",
      "kind": "static_lib",
      "name": "monitor_watchdog_client",
      "root": "core",
      "owns": [
        "include/monitor/client.hpp",
        "src/monitor/client.cpp"
      ],
      "dependencies": [
        "watchdog_contract:contract",
        "watchdog_platform:platform"
      ]
    },
    {
      "id": "watchdog_runtime:runtime",
      "kind": "static_lib",
      "name": "monitor_watchdog_runtime",
      "root": "core",
      "owns": [
        "include/monitor/watchdog.hpp",
        "src/monitor/watchdog.cpp",
        "include/monitor/observed_process.hpp",
        "src/monitor/observed_process.cpp"
      ],
      "dependencies": [
        "watchdog_client:client"
      ]
    },
    {
      "id": "watchdog_console:console",
      "kind": "static_lib",
      "name": "monitor_watchdog_console",
      "root": "core",
      "owns": [
        "include/monitor/console_watch.hpp",
        "src/monitor/console_watch.cpp"
      ],
      "dependencies": [
        "watchdog_runtime:runtime"
      ]
    },
    {
      "id": "watchdog_qt:qt",
      "kind": "static_lib",
      "name": "monitor_watchdog_qt",
      "root": "core",
      "owns": [
        "include/monitor/qt/gui_heartbeat.hpp",
        "src/monitor/qt/gui_heartbeat.cpp"
      ],
      "dependencies": [
        "watchdog_client:client"
      ],
      "packages": {
        "qt": [
          "Core"
        ]
      }
    },
    {
      "id": "watchdog_cli:cli",
      "kind": "exe",
      "name": "monitor",
      "root": "core",
      "owns": [
        "src/main.cpp"
      ],
      "entry": "src/main.cpp",
      "dependencies": [
        "watchdog_console:console"
      ]
    },
    {
      "id": "watchdog_tests:tests",
      "kind": "exe",
      "name": "monitor_watchdog_tests",
      "root": "core",
      "owns": [
        "tests/monitor/watchdog_tests.cpp"
      ],
      "entry": "tests/monitor/watchdog_tests.cpp",
      "dependencies": [
        "watchdog_console:console"
      ],
      "tests": {
        "qttest": false
      }
    }
  ]
}
