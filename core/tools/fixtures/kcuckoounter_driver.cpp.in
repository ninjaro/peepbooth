// Test-only startup driver for an owned, disposable Kcuckoounter process.
// Drives ordinary UI controls; never publishes or renews Monitor progress.
#include <QAbstractButton>
#include <QAction>
#include <QApplication>
#include <QDialog>
#include <QElapsedTimer>
#include <QFile>
#include <QJsonDocument>
#include <QJsonObject>
#include <QMenu>
#include <QRadioButton>
#include <QSocketNotifier>
#include <QTimer>
#include <QWidget>
#include <chrono>
#include <fcntl.h>
#include <monitor/shared_state.hpp>
#include <sys/mman.h>
#include <unistd.h>

class Driver : public QObject {
    Q_OBJECT
    QFile log;
    int fd { -1 };
    QElapsedTimer time;
    QWidget* window {};
    QSocketNotifier* notifier {};
    QByteArray pending;
    int command_id {};

public:
    Driver()
        : QObject(qApp)
        , log(QString::fromLocal8Bit(qgetenv("KC_DRIVER_LOG"))) {
        if (!log.open(QIODevice::WriteOnly | QIODevice::Text))
            qFatal("Cannot open driver evidence");
        time.start();
        for (auto* candidate : QApplication::topLevelWidgets())
            if (QString::fromLatin1(candidate->metaObject()->className())
                == "main_window")
                window = candidate;
        record("ready");
        if (!window) {
            record("error_no_main_window");
            qApp->exit(97);
            return;
        }
        connect(window, &QObject::destroyed, this, [this] {
            window = nullptr;
            record("window_destroyed");
        });
        connect(qApp, &QCoreApplication::aboutToQuit, this, [this] {
            record("about_to_quit");
            // The real main owns teardown. Do not inspect QWidget state once
            // control returns from exec() and the derived window is retired.
            window = nullptr;
        });
        for (auto* object : window->findChildren<QObject*>())
            if (object->metaObject()->indexOfSignal(
                    "rasterization_busy_changed(bool)"
                )
                >= 0)
                QObject::connect(
                    object, SIGNAL(rasterization_busy_changed(bool)), this,
                    SLOT(busy(bool))
                );
        fd = ::open(
            qgetenv("KC_DRIVER_FIFO").constData(),
            O_RDWR | O_NONBLOCK | O_CLOEXEC
        );
        if (fd < 0)
            qFatal("Cannot open driver FIFO");
        notifier = new QSocketNotifier(fd, QSocketNotifier::Read, this);
        connect(notifier, &QSocketNotifier::activated, this, [this] {
            char data[4096];
            const auto bytes = ::read(fd, data, sizeof(data));
            if (bytes <= 0)
                return;
            if (pending.size() + bytes > 4096)
                qFatal("Oversized driver command");
            pending.append(data, static_cast<int>(bytes));
            while (pending.contains('\n')) {
                const auto end = pending.indexOf('\n');
                const auto command = pending.left(end);
                pending.remove(0, end + 1);
                execute(command);
            }
        });
    }

    ~Driver() override {
        if (fd >= 0)
            ::close(fd);
    }

    void record(const QString& event, const QJsonObject& extra = {}) {
        QJsonObject data = extra;
        data["id"] = command_id;
        data["event"] = event;
        data["elapsed_ms"] = time.elapsed();
        data["monotonic_ns"] = QString::number(
            std::chrono::duration_cast<std::chrono::nanoseconds>(
                std::chrono::steady_clock::now().time_since_epoch()
            )
                .count()
        );
        if (window) {
            data["dpr"] = window->devicePixelRatioF();
            data["window_width"] = window->width();
            data["window_height"] = window->height();
        }
        const auto name = QByteArray("/monitor-watchdog-")
            + QByteArray::number(::getuid()) + "-"
            + QByteArray::number(::getpid());
        const int mapping = ::shm_open(name.constData(), O_RDONLY, 0);
        data["monitor_mapping"] = mapping >= 0;
        if (mapping >= 0) {
            void* address = ::mmap(
                nullptr, sizeof(monitor::shared_state), PROT_READ, MAP_SHARED,
                mapping, 0
            );
            if (address != MAP_FAILED) {
                const auto* state
                    = static_cast<const monitor::shared_state*>(address);
                const auto& gui = state->heartbeats[monitor::channel_index(
                    monitor::channel::gui
                )];
                data["gui_active"] = gui.active.load() != 0;
                data["gui_sequence"] = static_cast<qint64>(gui.sequence.load());
                data["gui_progress_ns"]
                    = QString::number(gui.timestamp_ns.load());
                ::munmap(address, sizeof(monitor::shared_state));
            }
            ::close(mapping);
        }
        log.write(QJsonDocument(data).toJson(QJsonDocument::Compact));
        log.write("\n");
        log.flush();
    }

    void execute(const QByteArray& command) {
        const auto object = QJsonDocument::fromJson(command).object();
        const auto action = object["action"].toString();
        command_id = object["id"].toInt();
        if (action == "mark") {
            record("mark", { { "label", object["label"] } });
        } else if (action == "trigger") {
            bool found = false;
            for (auto* item : window->findChildren<QAction*>())
                if ((!object["name"].toString().isEmpty()
                     && item->objectName() == object["name"].toString())
                    || (!item->menu() && !object["text"].toString().isEmpty()
                        && QString(item->text()).remove('&')
                            == object["text"].toString())) {
                    item->trigger();
                    found = true;
                    break;
                }
            record(
                "trigger", { { "name", object["name"] }, { "found", found } }
            );
        } else if (action == "theme") {
            bool found = false;
            for (auto* top : QApplication::topLevelWidgets()) {
                for (auto* item : top->findChildren<QRadioButton*>())
                    if (item->property("theme_source")
                            .toString()
                            .endsWith(object["source"].toString())) {
                        item->click();
                        found = true;
                        break;
                    }
                if (found)
                    break;
            }
            record(
                "theme", { { "source", object["source"] }, { "found", found } }
            );
        } else if (action == "button") {
            bool found = false;
            for (auto* top : QApplication::topLevelWidgets()) {
                for (auto* item : top->findChildren<QAbstractButton*>())
                    if (item->isVisible()
                        && QString(item->text()).remove('&')
                            == object["text"].toString()) {
                        item->click();
                        found = true;
                        break;
                    }
                if (found)
                    break;
            }
            record(
                "button", { { "text", object["text"] }, { "found", found } }
            );
        } else if (action == "resize") {
            window->resize(object["width"].toInt(), object["height"].toInt());
            record("resize");
        } else if (action == "close_settings") {
            for (auto* top : QApplication::topLevelWidgets())
                if (top != window && qobject_cast<QDialog*>(top))
                    top->close();
            record("close_settings");
        } else if (action == "close") {
            record("close_requested");
            window->close();
        } else
            record("error_command");
    }

public slots:

    void busy(bool value) { record("raster_busy", { { "busy", value } }); }
};

static void install_driver() {
    if (!qEnvironmentVariableIsEmpty("KC_DRIVER_LOG"))
        QTimer::singleShot(0, [] { new Driver; });
}
Q_COREAPP_STARTUP_FUNCTION(install_driver)
#include "kcuckoounter_driver.moc"
